#!/bin/sh
# eslint-pre-commit
# 由 scripts/git-hooks/install.mjs 安装到 .git/hooks，请勿手改。

set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

if ! command -v node >/dev/null 2>&1; then
    if [ -s "$HOME/.nvm/nvm.sh" ]; then
        NVM_DIR="$HOME/.nvm"
        export NVM_DIR
        set +u
        # shellcheck disable=SC1091
        . "$NVM_DIR/nvm.sh"
        set -u
    fi
fi

if ! command -v node >/dev/null 2>&1; then
    echo "[pre-commit] 未找到 node，无法执行 ESLint 校验" >&2
    exit 1
fi

exec node "$root/scripts/git-hooks/pre-commit.mjs"
